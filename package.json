		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
